{
    // gdb against Renode's own GDB server (no OpenOCD). Needs the C/C++
    // extension (cppdbg) and CMake Tools, and the settings mpfs.gdb /
    // mpfs.renode (.vscode/settings.json.example). See "Debugging in VS Code"
    // in the README.
    //
    // The gdb commands are the SoftConsole Renode launcher's: symbols load
    // before connecting (cppdbg's -file-exec-and-symbols on "program"), never
    // after; 'monitor start' starts the emulation, then gdb continues the
    // harts from the physical reset vector to s_mode_main.
    //
    // cppdbg treats the stop gdb reports on connecting as the launch's own:
    // it resumes from it (unless stopAtConnect), and a stop it did not ask
    // for is passed on only with the settings noted below.
    "version": "0.2.0",
    "configurations": [
        {
            // Builds, starts Renode (paused), connects, runs to s_mode_main.
            // Stopping the session also stops Renode.
            "name": "Debug in Renode",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:mpfs.gdb}",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                { "text": "set $target_riscv=1" },
                { "text": "set mem inaccessible-by-default off" },
                { "text": "set riscv use-compressed-breakpoints on" }
            ],
            "postRemoteConnectCommands": [
                { "text": "monitor start" },
                { "text": "tbreak s_mode_main" }
            ],
            "launchCompleteCommand": "exec-continue",
            // The tbreak is gdb's, not VS Code's: its hit is reported either
            // as the entry point (only stops with stopAtEntry) or as an
            // unknown breakpoint (stops as an exception unless "stop").
            "stopAtEntry": true,
            "unknownBreakpointHandling": "stop",
            "preLaunchTask": "Renode: start for debugging",
            "postDebugTask": "Renode: stop"
        },
        {
            // Connects to a Renode that is already listening on port 3333
            // (started with renode/debug.resc, or by the task above) and
            // stops wherever the harts are. Renode keeps running afterwards.
            "name": "Attach to running Renode",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:mpfs.gdb}",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                { "text": "set $target_riscv=1" },
                { "text": "set mem inaccessible-by-default off" },
                { "text": "set riscv use-compressed-breakpoints on" }
            ],
            "postRemoteConnectCommands": [
                { "text": "monitor start" }
            ],
            "launchCompleteCommand": "None",
            // Without it cppdbg resumes the harts after connecting.
            "stopAtConnect": true
        },
        {
            // Half of "Debug both boards" (below); not usable on its own.
            // Connects first and does not start the emulation: board1's
            // session does, so both boards run from reset under a debugger.
            "name": "board0 (both boards)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:mpfs.gdb}",
            "setupCommands": [
                { "text": "set $target_riscv=1" },
                { "text": "set mem inaccessible-by-default off" },
                { "text": "set riscv use-compressed-breakpoints on" }
            ],
            "miDebuggerServerAddress": "localhost:3333",
            "postRemoteConnectCommands": [
                { "text": "tbreak s_mode_main" }
            ],
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": true,
            "unknownBreakpointHandling": "stop",
            "postDebugTask": "Renode: stop both boards",
            "presentation": { "hidden": true }
        },
        {
            // Half of "Debug both boards"; connects 3 s after board0.
            "name": "board1 (both boards)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:mpfs.gdb}",
            "setupCommands": [
                { "text": "set $target_riscv=1" },
                { "text": "set mem inaccessible-by-default off" },
                { "text": "set riscv use-compressed-breakpoints on" }
            ],
            "miDebuggerServerAddress": "localhost:3334",
            "postRemoteConnectCommands": [
                { "text": "monitor start" },
                { "text": "tbreak s_mode_main" }
            ],
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": true,
            "unknownBreakpointHandling": "stop",
            "preLaunchTask": "Wait 3 s",
            "presentation": { "hidden": true }
        }
    ],
    "compounds": [
        {
            // The two boards of 'make sim' (renode/debug-dual.resc), one
            // debug session each, both stopped at s_mode_main. The boards
            // share one emulation clock: a board halted in the debugger
            // holds the other back too, so continue both.
            "name": "Debug both boards",
            "configurations": ["board0 (both boards)", "board1 (both boards)"],
            "preLaunchTask": "Renode: start both boards for debugging",
            "stopAll": true
        }
    ]
}
