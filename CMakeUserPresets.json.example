{
  "version": 3,
  "configurePresets": [
    {
      "name": "local",
      "inherits": "debug",
      "displayName": "Debug (this machine)",
      "description": "Copy this file to CMakeUserPresets.json (git-ignored) and set the paths of this machine. Leave out what is found automatically.",
      "binaryDir": "${sourceDir}/build-cmake/local",
      "cacheVariables": {
        "RENODE": "C:/Microchip/SoftConsole-v2022.2-RISC-V-747/renode/bin/Renode.exe",
        "PYTHON": "C:/Python312/python.exe",
        "RENODE_TEST": "C:/Microchip/SoftConsole-v2022.2-RISC-V-747/renode/renode-test.bat",
        "RENODE_FLAGS": "--disable-xwt;--console"
      },
      "environment": {
        "PATH": "C:/Python312;C:/Python312/Scripts;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    { "name": "local", "configurePreset": "local", "displayName": "Debug (this machine)" }
  ],
  "testPresets": [
    {
      "name": "local",
      "configurePreset": "local",
      "displayName": "Debug (this machine): all tests",
      "output": { "outputOnFailure": true }
