# SPDX-License-Identifier: MIT
#
# The two boards of 'make sim' (board-setup.resc: same ELF, board1 strapped
# as id 1, both on the Ethernet switch), waiting for debuggers: one GDB
# server per board, emulation paused until a gdb sends 'monitor start'.
# Used by the VS Code dual-board debug configurations (.vscode/tasks.json);
# by hand, from the project root:
#
#   renode -e "include @renode/debug-dual.resc"
#
# then connect one gdb per board (localhost:3333 board0, localhost:3334
# board1), see "Debugging in VS Code" in the README.
#
# Variables:
#   $elf          program, default the make build's
#   $gdb_port     board0's GDB server, default 3333
#   $gdb_port_b   board1's GDB server, default 3334
#
# Both boards share one emulation clock: while a gdb holds one board halted,
# the other does not run either. 'monitor start' (either gdb) starts both.

$gdb_port?=3333
$gdb_port_b?=3334

include @renode/board-setup.resc

runMacro $two_boards

mach set "board0"
showAnalyzer sysbus.mmuart1
machine StartGdbServer $gdb_port

mach set "board1"
showAnalyzer sysbus.mmuart1
machine StartGdbServer $gdb_port_b

echo "debug-dual.resc: GDB servers ready on ports"
echo $gdb_port
echo $gdb_port_b
