// SPDX-License-Identifier: MIT
//
// Simulated devices attached to the PolarFire SoC MSS peripherals
// (mpfs-freertos-smode, branch sim-peripherals). Loaded after the board's
// platform and after the C# models it uses have been included (see the
// debug launcher, or renode/README.md).
//
// MPFS_SPI takes a single slave per controller (no chip-select routing).

// Phase 4: example-protocol device on spi1 (replaced the Phase 1 loopback).
// DataReady (high while events are queued) -> F2M_1, PLIC 119.
proto: SPI.ProtoSpiDevice @ spi1
    DataReady -> plic@119

// Phase 2: SPI NOR flash on spi0 (16 MiB, JEDEC ID EF 40 18).
flash: SPI.NorFlash @ spi0

// Phase 3: our MSS I2C controller model in place of the built-in MPFS_I2C on
// i2c0 (see renode/README.md). The built-in one must be removed first:
//   machine UnregisterFromParent sysbus.i2c0
i2c0: I2C.MpfsI2c @ sysbus 0x2010A000
    IRQ -> plic@58

// AT24C256-like EEPROM, 32 KiB, 64-byte pages, at 0x50.
eeprom: I2C.I2cEeprom @ i2c0 0x50

// Phase 5a: LiteEth soft MAC in the fabric, behind FIC3 (Renode's built-in
// LiteX_Ethernet). CSRs, slot buffers, MDIO; IRQ -> F2M_2, PLIC 120.
// Its MAC must match the firmware's (02:4d:50:46:53:<board id>): the switch
// delivers unicast frames only to the interface whose MAC matches. A repl
// cannot set a MACAddress in 1.13, so the launcher and run-demo.resc do it:
//   sysbus.eth MAC "02:4d:50:46:53:00"
eth: Network.LiteX_Ethernet @ {
        sysbus 0x40000000;
        sysbus new Bus.BusMultiRegistration { address: 0x40010000; size: 0x2000; region: "buffer" };
        sysbus new Bus.BusMultiRegistration { address: 0x40001000; size: 0x100; region: "phy" }
    }
    IRQ -> plic@120

// Phase 5b: a PHY on the LiteEth MDIO bus, address 1 (the network interface
// reads its ID and link state). IDs of a Microchip KSZ8081 (vendor 0x0022).
// The model reports link up and auto-negotiation complete.
ethphy: Network.EthernetPhysicalLayer @ eth 1
    Id1: 0x0022
    Id2: 0x1561
