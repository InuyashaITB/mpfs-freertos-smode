# SPDX-License-Identifier: MIT
#
# The board set-up shared by every Renode script here: the models, the
# $board macro (one board as the SoftConsole debug launcher loads it) and the
# $two_boards macro (board0 and board1 on the Ethernet switch "sw"). Defines
# macros only; include it before any machine exists (a macro defined while a
# machine is selected is only visible from that machine).
#
# Every path here is relative to the working directory, so start Renode in
# the project root ($ORIGIN is not expanded inside paths in 1.13), or add
# the project root with 'path add'.
#
#   $elf   the program, the same on both boards (default: the make build's)

$elf?=@build/examples/freertos-demo/freertos-demo.elf

include @renode/models/ProtoSpiDevice.cs
include @renode/models/NorFlash.cs
include @renode/models/MpfsI2c.cs
include @renode/models/I2cEeprom.cs

# One board: the platform, the DDR window, i2c0 replaced by MpfsI2c, the
# simulated devices, and the program, with every hart at the physical reset
# vector (as the debug launcher does with 'set $pc'). LoadELF uses the
# physical (load) addresses.
macro board
"""
    machine LoadPlatformDescription @platforms/cpus/polarfire-soc.repl
    machine LoadPlatformDescription @renode/mpfs-ddr-38bit-cached-3gib.repl
    machine UnregisterFromParent sysbus.i2c0
    machine LoadPlatformDescription @renode/mpfs-sim-peripherals.repl

    # MPFS_SPI does not implement the SPS/CLKMODE bits or FRAMESUP and warns
    # on every transfer; harmless (see renode/README.md).
    logLevel 3 sysbus.spi0
    logLevel 3 sysbus.spi1

    sysbus LoadELF $elf
    sysbus.e51 PC 0x08000000
    sysbus.u54_1 PC 0x08000000
    sysbus.u54_2 PC 0x08000000
    sysbus.u54_3 PC 0x08000000
    sysbus.u54_4 PC 0x08000000
"""

# Two boards on one switch. They differ only in the GPIO2_0 strap (board id).
# The LiteEth model's MAC is set to the firmware's (02:4d:50:46:53:<id>) so
# the switch's log names the boards; the switch learns addresses from the
# frames themselves. Leaves board1 selected.
macro two_boards
"""
    emulation CreateSwitch "sw"

    mach create "board0"
    runMacro $board
    sysbus.eth MAC "02:4d:50:46:53:00"
    connector Connect sysbus.eth sw

    mach create "board1"
    runMacro $board
    # Strap GPIO2_0 = 1. MPFS_GPIO ignores an input that is not configured
    # as one, so configure it here first (GPIO_CFG[0] = input); the
    # firmware's own configuration later keeps the state.
    sysbus WriteDoubleWord 0x20122000 0x2
    sysbus.gpio2 OnGPIO 0 true
    sysbus.eth MAC "02:4d:50:46:53:01"
    connector Connect sysbus.eth sw
"""
