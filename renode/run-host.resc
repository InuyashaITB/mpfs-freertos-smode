:name: mpfs-freertos-smode demo with the host on the network (headless, two boards)
:description: run-demo.resc plus the SocketBridge model, which connects the boards' switch to renode/host_bridge.py on the host over localhost UDP (no TAP, no administrator rights).

# Normally run by 'make sim-host' (top-level Makefile), which also starts
# renode/host_bridge.py and checks the output. By hand: start the helper
#
#   python renode/host_bridge.py --ping 192.168.10.10 --ping 192.168.10.11
#
# then Renode in the project root, with the same variables as run-demo.resc:
#
#   renode --disable-xwt --console -e "$uart_log=@/abs/uart1.txt; $uart_log_b=@/abs/uart1-board1.txt; include @renode/run-host.resc"

include @renode/models/SocketBridge.cs
include @renode/boards.resc

mach set "board0"
machine LoadPlatformDescription @renode/host-bridge.repl
connector Connect sysbus.bridge sw

runMacro $run_and_report
echo "run-host: bridge frames to host, from host:"
mach set "board0"
sysbus.bridge FramesToHost
sysbus.bridge FramesFromHost
echo "run-host: done"
quit
