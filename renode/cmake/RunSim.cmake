# SPDX-License-Identifier: MIT
#
# One headless Renode run of the two-board demo plus the UART checks: the
# CMake/CTest twin of 'make sim' and 'make sim-host' (no shell needed).
#
#   cmake -DRENODE=<Renode executable> -DPROJECT=<project root>
#         -DOUT=<output directory> [-DRENODE_FLAGS="--disable-xwt;--console"]
#         [-DRUNTIME=3] [-DSCRIPT=run-demo|run-host] [-DPYTHON=<python3>]
#         [-DELF=<program>] -P RunSim.cmake
#
# SCRIPT=run-demo (default): renode/run-demo.resc.
# SCRIPT=run-host: renode/run-host.resc with renode/host_bridge.py, which needs
# PYTHON. The helper runs in the same execute_process() as Renode (CMake
# starts the commands of one call together); it stops by itself once frames
# stop (--exit-idle), with --duration as the upper bound.
#
# Outputs in OUT: uart1.txt, uart1-board1.txt, renode.log, sim.resc (the
# generated start script), and for run-host host.txt (the helper's events)
# and stderr.log.

foreach(_v RENODE PROJECT OUT)
    if(NOT ${_v})
        message(FATAL_ERROR "RunSim.cmake: set -D${_v}=...")
    endif()
endforeach()
# RENODE_FLAGS_PIPE: the same as a '|'-separated string (what CTest passes:
# ';' would split the -D argument).
if(DEFINED RENODE_FLAGS_PIPE)
    string(REPLACE "|" ";" RENODE_FLAGS "${RENODE_FLAGS_PIPE}")
endif()
if(NOT DEFINED RENODE_FLAGS)
    set(RENODE_FLAGS --disable-xwt --console)
endif()
if(NOT RUNTIME)
    set(RUNTIME 3)
endif()
if(NOT SCRIPT)
    set(SCRIPT run-demo)
endif()
if(NOT SCRIPT MATCHES "^(run-demo|run-host)$")
    message(FATAL_ERROR "RunSim.cmake: SCRIPT must be run-demo or run-host, not ${SCRIPT}")
endif()
if(SCRIPT STREQUAL "run-host" AND NOT PYTHON)
    message(FATAL_ERROR "RunSim.cmake: SCRIPT=run-host needs -DPYTHON=<Python 3>")
endif()

file(MAKE_DIRECTORY "${OUT}")
get_filename_component(OUT "${OUT}" ABSOLUTE)
set(_uart0 "${OUT}/uart1.txt")
set(_uart1 "${OUT}/uart1-board1.txt")
set(_renode_log "${OUT}/renode.log")
set(_host "${OUT}/host.txt")
file(REMOVE "${_uart0}" "${_uart1}" "${_host}")

# Renode reads the monitor console from stdin. With a null device it gets
# end-of-file, so it exits even if a script command fails (as in the
# Makefile). The paths given to the script must be absolute (Renode 1.13).
if(CMAKE_HOST_WIN32)
    set(_null NUL)
else()
    set(_null /dev/null)
endif()
# The variables and the include go into a small generated script: a single
# -e argument with semicolons would be split by CMake's list handling.
set(_sim_resc "${OUT}/sim.resc")
set(_text "# Generated by renode/cmake/RunSim.cmake\n")
string(APPEND _text "$uart_log=@${_uart0}\n$uart_log_b=@${_uart1}\n$runtime=\"${RUNTIME}\"\n")
if(ELF)
    get_filename_component(ELF "${ELF}" ABSOLUTE)
    string(APPEND _text "$elf=@${ELF}\n")
endif()
string(APPEND _text "include @renode/${SCRIPT}.resc\n")
file(WRITE "${_sim_resc}" "${_text}")
set(_renode_cmd "${RENODE}" ${RENODE_FLAGS} -e "include @${_sim_resc}")

message(STATUS "SIM ${RUNTIME} s after the first one, ${SCRIPT}, log: ${_renode_log}")
if(SCRIPT STREQUAL "run-host")
    # The helper is the first command: its stdout (empty with --quiet) is
    # piped to Renode's stdin and closes when the helper exits.
    execute_process(
        COMMAND "${PYTHON}" "${PROJECT}/renode/host_bridge.py"
                --ping 192.168.10.10 --ping 192.168.10.11
                --exit-idle 20 --duration 600 --quiet --report "${_host}"
        COMMAND ${_renode_cmd}
        WORKING_DIRECTORY "${PROJECT}"
        OUTPUT_FILE "${_renode_log}"
        ERROR_FILE "${OUT}/stderr.log"
        RESULTS_VARIABLE _results)
else()
    execute_process(
        COMMAND ${_renode_cmd}
        WORKING_DIRECTORY "${PROJECT}"
        INPUT_FILE "${_null}"
        OUTPUT_FILE "${_renode_log}"
        ERROR_VARIABLE _stderr
        RESULTS_VARIABLE _results)
    file(APPEND "${_renode_log}" "${_stderr}")
endif()
message(STATUS "exit codes: ${_results}")

# The checks (CheckUart.cmake), the same lists as the Makefile.
set(_r "${PROJECT}/renode")
set(_common "${_r}/expected-uart.txt")
set(_board0 "${_r}/expected-uart-board0.txt")
if(SCRIPT STREQUAL "run-host")
    string(APPEND _common "|${_r}/expected-host-board.txt")
endif()

set(_failed "")
foreach(_check IN ITEMS board0 board1 host)
    if(_check STREQUAL "board0")
        set(_args -DUART=${_uart0} -DRENODE_LOG=${_renode_log} "-DEXPECTED=${_common}|${_board0}")
    elseif(_check STREQUAL "board1")
        set(_args -DUART=${_uart1} -DRENODE_LOG=${_renode_log} "-DEXPECTED=${_common}")
    elseif(SCRIPT STREQUAL "run-host")
        set(_args -DUART=${_host} -DRENODE_LOG=${OUT}/stderr.log "-DEXPECTED=${_r}/expected-host.txt")
    else()
        continue()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${_args} -P "${CMAKE_CURRENT_LIST_DIR}/CheckUart.cmake"
                    RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        list(APPEND _failed ${_check})
    endif()
endforeach()

if(_failed)
    message(FATAL_ERROR "sim: check failed for: ${_failed} (outputs in ${OUT})")
endif()
message(STATUS "sim: PASS")
