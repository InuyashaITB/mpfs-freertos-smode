// SPDX-License-Identifier: MIT
//
// Phase 5c: user-mode bridge to the host (renode/models/SocketBridge.cs).
// Frames on the switch <-> UDP datagrams on 127.0.0.1: the bridge listens on
// port 37001 and sends to port 37000, where renode/host_bridge.py runs.
// Registered in an unused corner of the fabric window only so that it can be
// created here and attached with 'connector Connect sysbus.bridge sw'; its
// two registers are frame counters.
bridge: Network.SocketBridge @ sysbus 0x40002000
    localPort: 37001
    remotePort: 37000
